{
  "html.validate.scripts": false,
  "html.validate.styles": false,
  "files.associations": {
    "*.html": "html"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.next": true
  },
  "search.exclude": {
    "**/.next": true,
    "**/node_modules": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.next/**": true,
    "**/node_modules/**": true
  }
}
